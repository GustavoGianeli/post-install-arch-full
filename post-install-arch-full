FUNCAO_INSTALAR_ARCH_UPDATE_FULL() {
    local resp_update=""
    local escolha_helper=""
    local has_yay=false
    local has_paru=false
    local helper_usado=""
    local usar_git=0
    local temp_dir=""
    local install_status=0

    # Já instalado: nada a fazer (evita perguntar e reinstalar à toa)
    if pacman -Q arch-update-full &>/dev/null; then
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        msg "${CYAN_NEON}O arch-update-full já está instalado no sistema. Continuando o script...${NC}" \
            "${CYAN_NEON}Arch-update-full is already installed on the system. Continuing script...${NC}" \
            "${CYAN_NEON}Arch-update-full ya está instalado en el sistema. Continuando el script...${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        return 0
    fi

    while true; do
        echo -e "${NEON_BLUE}----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------${NC}"
        msg "${CYAN_NEON}O arch-update-full é uma ferramenta altamente recomendada para verificar as atualizações disponíveis no sistema e deixar seu Arch sempre atualizado e limpo. Deseja instalá-la agora? (s/n):${NC}" \
            "${CYAN_NEON}Arch-update-full is a highly recommended tool to check available system updates and keep your Arch always updated and clean. Do you want to install it now? (y/n):${NC}" \
            "${CYAN_NEON}Arch-update-full es una herramienta altamente recomendada para verificar las actualizaciones disponibles en el sistema y mantener tu Arch siempre actualizado y limpio. ¿Deseas instalarla ahora? (s/n):${NC}"
        echo -e "${NEON_BLUE}-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------${NC}"
        echo ""
        if ! read -rp "Opção / Choice / Opción [s/y/n]: " resp_update; then
            return 1
        fi
        resp_update="${resp_update//[[:space:]]/}"
        resp_update="${resp_update,,}"

        case "$resp_update" in
            s|sim|y|yes)
                break
                ;;
            n|no|nao|não)
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                msg "${YELLOW_NEON}Instalação do arch-update-full ignorada. Continuando o script...${NC}" \
                    "${YELLOW_NEON}Arch-update-full installation skipped. Continuing script...${NC}" \
                    "${YELLOW_NEON}Instalación de arch-update-full omitida. Continuando el script...${NC}"
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                return 0
                ;;
            *)
                msg "${RED_NEON}[ERRO] Opção inválida. Digite 's' para sim ou 'n' para não.${NC}" \
                    "${RED_NEON}[ERROR] Invalid option. Type 'y' for yes or 'n' for no.${NC}" \
                    "${RED_NEON}[ERROR] Opción inválida. Escribe 's' para sí o 'n' para no.${NC}"
                echo ""
                ;;
        esac
    done

    # makepkg, yay e paru se recusam a rodar como root
    if [ "$(id -u)" -eq 0 ]; then
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        msg "${RED_NEON}[ERRO] Pacotes do AUR não podem ser instalados como root. Execute o script com um usuário comum (com sudo).${NC}" \
            "${RED_NEON}[ERROR] AUR packages cannot be installed as root. Run the script as a regular user (with sudo).${NC}" \
            "${RED_NEON}[ERROR] Los paquetes del AUR no pueden instalarse como root. Ejecuta el script con un usuario normal (con sudo).${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        return 1
    fi

    command -v yay &>/dev/null && has_yay=true
    command -v paru &>/dev/null && has_paru=true

    if [ "$has_yay" = true ] && [ "$has_paru" = true ]; then
        while true; do
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            msg "${YELLOW_NEON}Tanto o 'yay' quanto o 'paru' foram detectados. Qual helper deseja utilizar?${NC}" \
                "${YELLOW_NEON}Both 'yay' and 'paru' detected. Which helper do you want to use?${NC}" \
                "${YELLOW_NEON}Se detectaron tanto 'yay' como 'paru'. ¿Qué asistente deseas utilizar?${NC}"
            
            echo ""
            echo -e "${CYAN_NEON}  [1] yay${NC}"
            echo ""
            echo -e "${CYAN_NEON}  [2] paru${NC}"
            echo ""
            msg "${CYAN_NEON}  [0] Pular instalação${NC}" \
                "${CYAN_NEON}  [0] Skip installation${NC}" \
                "${CYAN_NEON}  [0] Omitir instalación${NC}"
            echo ""
            if ! read -rp "Escolha / Choice / Opción [1/2/0]: " escolha_helper; then
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                return 1
            fi
            escolha_helper="${escolha_helper//[[:space:]]/}"
            escolha_helper="${escolha_helper,,}"
            case "$escolha_helper" in
                1|yay)
                    helper_usado="yay"
                    break
                    ;;
                2|paru)
                    helper_usado="paru"
                    break
                    ;;
                0|n|no|nao|não)
                    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                    msg "${YELLOW_NEON}Instalação do arch-update-full ignorada. Continuando o script...${NC}" \
                        "${YELLOW_NEON}Arch-update-full installation skipped. Continuing script...${NC}" \
                        "${YELLOW_NEON}Instalación de arch-update-full omitida. Continuando el script...${NC}"
                    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                    return 0
                    ;;
                *)
                    msg "${RED_NEON}[ERRO] Opção inválida. Digite 1 para yay, 2 para paru ou 0 para pular.${NC}" \
                        "${RED_NEON}[ERROR] Invalid option. Type 1 for yay, 2 for paru or 0 to skip.${NC}" \
                        "${RED_NEON}[ERROR] Opción inválida. Escribe 1 para yay, 2 para paru o 0 para omitir.${NC}"
                    echo ""
                    ;;
            esac
        done

        msg "${GREEN_NEON}Utilizando o ${helper_usado} para instalar o arch-update-full...${NC}" \
            "${GREEN_NEON}Using ${helper_usado} to install arch-update-full...${NC}" \
            "${GREEN_NEON}Usando ${helper_usado} para instalar arch-update-full...${NC}"
        echo ""
    elif [ "$has_yay" = true ]; then
        helper_usado="yay"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        msg "${CYAN_NEON}Helper 'yay' detectado. Instalando arch-update-full...${NC}" \
            "${CYAN_NEON}Helper 'yay' detected. Installing arch-update-full...${NC}" \
            "${CYAN_NEON}Asistente 'yay' detectado. Instalando arch-update-full...${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        echo ""
    elif [ "$has_paru" = true ]; then
        helper_usado="paru"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        msg "${CYAN_NEON}Helper 'paru' detectado. Instalando arch-update-full...${NC}" \
            "${CYAN_NEON}Helper 'paru' detected. Installing arch-update-full...${NC}" \
            "${CYAN_NEON}Asistente 'paru' detectado. Instalando arch-update-full...${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        echo ""
    else
        usar_git=1
        echo ""
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        msg "${YELLOW_NEON}Nenhum AUR helper detectado. Clonando e compilando via Git em diretório seguro (mktemp)...${NC}" \
            "${YELLOW_NEON}No AUR helper detected. Cloning and building via Git in a secure directory (mktemp)...${NC}" \
            "${YELLOW_NEON}Ningún asistente de AUR detectado. Clonando y compilando vía Git en un directorio seguro (mktemp)...${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        echo ""
    fi

    if [ -n "$helper_usado" ]; then
        "$helper_usado" -S --needed --noconfirm arch-update-full
        install_status=$?

        if [ "$install_status" -eq 0 ] && ! pacman -Q arch-update-full &>/dev/null; then
            install_status=1
        fi

        if [ "$install_status" -ne 0 ]; then
            echo ""
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            msg "${YELLOW_NEON}[AVISO] A instalação via ${helper_usado} falhou. Tentando via Git + makepkg...${NC}" \
                "${YELLOW_NEON}[WARNING] Installation via ${helper_usado} failed. Trying via Git + makepkg...${NC}" \
                "${YELLOW_NEON}[AVISO] La instalación vía ${helper_usado} falló. Intentando vía Git + makepkg...${NC}"
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            echo ""
            usar_git=1
        fi
    fi

    if [ "$usar_git" -eq 1 ]; then
        install_status=1

        if ! sudo pacman -S --needed --noconfirm git base-devel; then
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            msg "${RED_NEON}[ERRO] Falha ao instalar os pré-requisitos (git e base-devel).${NC}" \
                "${RED_NEON}[ERROR] Failed to install the prerequisites (git and base-devel).${NC}" \
                "${RED_NEON}[ERROR] Error al instalar los requisitos previos (git y base-devel).${NC}"
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            return 1
        fi

        temp_dir=$(mktemp -d) || temp_dir=""
        if [ -n "$temp_dir" ] && [ -d "$temp_dir" ]; then
            if git clone --quiet https://aur.archlinux.org/arch-update-full.git "$temp_dir/arch-update-full"; then
                if (cd "$temp_dir/arch-update-full" && makepkg -si --noconfirm); then
                    install_status=0
                else
                    install_status=1
                fi
                rm -rf "$temp_dir"
            else
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                msg "${RED_NEON}[ERRO] Falha ao clonar o repositório arch-update-full do AUR.${NC}" \
                    "${RED_NEON}[ERROR] Failed to clone arch-update-full repository from AUR.${NC}" \
                    "${RED_NEON}[ERROR] Error al clonar el repositorio arch-update-full de AUR.${NC}"
                rm -rf "$temp_dir"
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                return 1
            fi
        else
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            msg "${RED_NEON}[ERRO] Falha ao criar diretório temporário para build.${NC}" \
                "${RED_NEON}[ERROR] Failed to create temporary directory for build.${NC}" \
                "${RED_NEON}[ERROR] Error al crear el directorio temporal para la compilación.${NC}"
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            return 1
        fi
    fi

    if [ "$install_status" -eq 0 ] && ! pacman -Q arch-update-full &>/dev/null; then
        install_status=1
    fi

    echo ""
    if [ "$install_status" -eq 0 ]; then
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        msg "${CYAN_NEON}[SUCESSO] Arch Update Full instalado e integrado com sucesso ao sistema!${NC}" \
            "${CYAN_NEON}[SUCCESS] Arch Update Full successfully installed and integrated!${NC}" \
            "${CYAN_NEON}[ÉXITO] Arch Update Full instalado e integrado con éxito.${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
    else
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        msg "${RED_NEON}[ERRO] A instalação do Arch Update Full falhou durante o processo.${NC}" \
            "${RED_NEON}[ERROR] Arch Update Full installation failed during the process.${NC}" \
            "${RED_NEON}[ERROR] La instalación de Arch Update Full falló durante el proceso.${NC}"
            echo ""
        msg "${YELLOW_NEON}Você pode instalar manualmente depois com: yay -S arch-update-full (ou paru -S arch-update-full)${NC}" \
            "${YELLOW_NEON}You can install it manually later with: yay -S arch-update-full (or paru -S arch-update-full)${NC}" \
            "${YELLOW_NEON}Puedes instalarlo manualmente después con: yay -S arch-update-full (o paru -S arch-update-full)${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        return 1
    fi
    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
    return 0
}

FUNCAO_INSTALAR_WALLPAPERS() {
    local resp_wall=""
    local zip_nome="wallpapers personalizados.zip"
    local zip_url="https://raw.githubusercontent.com/GustavoGianeli/post-install-arch-full/main/wallpapers%20personalizados.zip"
    local alvo_user=""
    local alvo_home=""
    local img_dir=""
    local target_folder=""
    local script_dir=""
    local candidato=""
    local zip_usar=""
    local zip_temp=""
    local qtd_imgs=0
    local -a candidatos=()
    local -a como_user=()

    while true; do
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        msg "${CYAN_NEON}Deseja instalar os wallpapers personalizados do Projeto Odin? (s/n):${NC}" \
            "${CYAN_NEON}Do you want to install Project Odin's custom wallpapers? (y/n):${NC}" \
            "${CYAN_NEON}¿Deseas instalar los fondos de pantalla personalizados del Proyecto Odin? (s/n):${NC}"
        echo ""
        if ! read -rp "Opção / Choice / Opción [s/y/n]: " resp_wall; then
            return 1
        fi
        resp_wall="${resp_wall//[[:space:]]/}"
        resp_wall="${resp_wall,,}"

        case "$resp_wall" in
            s|sim|y|yes)
                break
                ;;
            n|no|nao|não)
                msg "${YELLOW_NEON}Instalação de wallpapers ignorada. Continuando o script...${NC}" \
                    "${YELLOW_NEON}Wallpapers installation skipped. Continuing script...${NC}" \
                    "${YELLOW_NEON}Instalación de fondos de pantalla omitida. Continuando el script...${NC}"
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                return 0
                ;;
            *)
                msg "${RED_NEON}[ERRO] Opção inválida. Digite 's' para sim ou 'n' para não.${NC}" \
                    "${RED_NEON}[ERROR] Invalid option. Type 'y' for yes or 'n' for no.${NC}" \
                    "${RED_NEON}[ERROR] Opción inválida. Escribe 's' para sí o 'n' para no.${NC}"
                echo ""
                ;;
        esac
    done
    echo ""

    
    
    if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
        alvo_user="$SUDO_USER"
        alvo_home="$(getent passwd "$alvo_user" | cut -d: -f6)"
        como_user=(sudo -u "$alvo_user")
    else
        alvo_home="$HOME"
    fi

    if [ -z "$alvo_home" ] || [ ! -d "$alvo_home" ]; then
        msg "${RED_NEON}[ERRO] Não foi possível localizar a pasta pessoal do usuário.${NC}" \
            "${RED_NEON}[ERROR] Could not locate the user's home folder.${NC}" \
            "${RED_NEON}[ERROR] No se pudo localizar la carpeta personal del usuario.${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        return 1
    fi

    if command -v xdg-user-dir &>/dev/null; then
        img_dir="$(env -u XDG_CONFIG_HOME HOME="$alvo_home" xdg-user-dir PICTURES 2>/dev/null)"
    fi
    if [ -z "$img_dir" ] || [ "$img_dir" = "$alvo_home" ]; then
        if [ -d "$alvo_home/Imagens" ]; then
            img_dir="$alvo_home/Imagens"
        elif [ -d "$alvo_home/Pictures" ]; then
            img_dir="$alvo_home/Pictures"
        elif [ "${IDIOMA_SISTEMA:-}" = "PT_BR" ]; then
            img_dir="$alvo_home/Imagens"
        else
            img_dir="$alvo_home/Pictures"
        fi
    fi
    target_folder="$img_dir/wallpapers personalizados"

    # ---------------------------------------------------------------
    # 2) unzip é indispensável (inclusive para validar o zip); instala se faltar
    # ---------------------------------------------------------------
    if ! command -v unzip &>/dev/null; then
        msg "${YELLOW_NEON}O comando 'unzip' não foi encontrado. Instalando o pacote unzip...${NC}" \
            "${YELLOW_NEON}The 'unzip' command was not found. Installing the unzip package...${NC}" \
            "${YELLOW_NEON}No se encontró el comando 'unzip'. Instalando el paquete unzip...${NC}"
        echo ""
        if ! sudo pacman -S --needed --noconfirm unzip || ! command -v unzip &>/dev/null; then
            msg "${RED_NEON}[ERRO] Não foi possível instalar o 'unzip'. Instale o pacote unzip e tente novamente.${NC}" \
                "${RED_NEON}[ERROR] Could not install 'unzip'. Install the unzip package and try again.${NC}" \
                "${RED_NEON}[ERROR] No se pudo instalar 'unzip'. Instala el paquete unzip e inténtalo de nuevo.${NC}"
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            return 1
        fi
        echo ""
    fi

    # ---------------------------------------------------------------
    # 3) Procura primeiro um zip local (git clone / instalação com o zip incluso); só baixa se não achar
    # ---------------------------------------------------------------
    if [ -n "${BASH_SOURCE[0]:-}" ]; then
        script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)"
    fi
    [ -n "$script_dir" ] && candidatos+=("$script_dir/$zip_nome")
    candidatos+=(
        "$PWD/$zip_nome"
        "$alvo_home/post-install-arch-full/$zip_nome"
        "/usr/share/post-install-arch-full/$zip_nome"
    )

    msg "${CYAN_NEON}Procurando o pacote de wallpapers neste computador...${NC}" \
        "${CYAN_NEON}Looking for the wallpapers package on this computer...${NC}" \
        "${CYAN_NEON}Buscando el paquete de fondos de pantalla en este equipo...${NC}"
    echo ""

    for candidato in "${candidatos[@]}"; do
        [ -f "$candidato" ] || continue
        if unzip -tq "$candidato" &>/dev/null; then
            zip_usar="$candidato"
            break
        fi
        msg "${YELLOW_NEON}[AVISO] Zip encontrado em '$candidato', mas está corrompido ou incompleto. Ignorando...${NC}" \
            "${YELLOW_NEON}[WARNING] Zip found at '$candidato', but it is corrupted or incomplete. Ignoring...${NC}" \
            "${YELLOW_NEON}[AVISO] Zip encontrado en '$candidato', pero está dañado o incompleto. Ignorando...${NC}"
        echo ""
    done

    if [ -n "$zip_usar" ]; then
        msg "${CYAN_NEON}Pacote local encontrado: $zip_usar (download não necessário).${NC}" \
            "${CYAN_NEON}Local package found: $zip_usar (no download needed).${NC}" \
            "${CYAN_NEON}Paquete local encontrado: $zip_usar (no es necesario descargar).${NC}"
        echo ""
    else
        # -------------------------------------------------------------
        # 4) Não achou local: baixa do GitHub para um arquivo temporário
        # -------------------------------------------------------------
        msg "${CYAN_NEON}Nenhum pacote local encontrado. Baixando do GitHub...${NC}" \
            "${CYAN_NEON}No local package found. Downloading from GitHub...${NC}" \
            "${CYAN_NEON}No se encontró ningún paquete local. Descargando desde GitHub...${NC}"
        echo ""

        if ! command -v curl &>/dev/null; then
            msg "${YELLOW_NEON}O comando 'curl' não foi encontrado. Instalando o pacote curl...${NC}" \
                "${YELLOW_NEON}The 'curl' command was not found. Installing the curl package...${NC}" \
                "${YELLOW_NEON}No se encontró el comando 'curl'. Instalando el paquete curl...${NC}"
            echo ""
            if ! sudo pacman -S --needed --noconfirm curl || ! command -v curl &>/dev/null; then
                msg "${RED_NEON}[ERRO] Não foi possível instalar o 'curl'. Instale o pacote curl e tente novamente.${NC}" \
                    "${RED_NEON}[ERROR] Could not install 'curl'. Install the curl package and try again.${NC}" \
                    "${RED_NEON}[ERROR] No se pudo instalar 'curl'. Instala el paquete curl e inténtalo de nuevo.${NC}"
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                return 1
            fi
            echo ""
        fi

        zip_temp="$(mktemp --suffix=.zip)" || zip_temp=""
        if [ -z "$zip_temp" ] || [ ! -f "$zip_temp" ]; then
            msg "${RED_NEON}[ERRO] Falha ao criar arquivo temporário para o download.${NC}" \
                "${RED_NEON}[ERROR] Failed to create temporary file for download.${NC}" \
                "${RED_NEON}[ERROR] Error al crear el archivo temporal para la descarga.${NC}"
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            return 1
        fi
        chmod 644 "$zip_temp"

        if ! curl -fL --progress-bar --connect-timeout 15 --max-time 600 --retry 2 -o "$zip_temp" "$zip_url"; then
            rm -f "$zip_temp"
            echo ""
            msg "${RED_NEON}[ERRO] Falha ao baixar o pacote de wallpapers do repositório. Verifique sua conexão com a internet.${NC}" \
                "${RED_NEON}[ERROR] Failed to download wallpapers package from the repository. Check your internet connection.${NC}" \
                "${RED_NEON}[ERROR] Error al descargar el paquete de fondos de pantalla del repositorio. Verifica tu conexión a internet.${NC}"
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            return 1
        fi
        echo ""

        if ! unzip -tq "$zip_temp" &>/dev/null; then
            rm -f "$zip_temp"
            msg "${RED_NEON}[ERRO] O arquivo baixado está corrompido ou incompleto.${NC}" \
                "${RED_NEON}[ERROR] The downloaded file is corrupted or incomplete.${NC}" \
                "${RED_NEON}[ERROR] El archivo descargado está dañado o incompleto.${NC}"
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            return 1
        fi
        zip_usar="$zip_temp"
    fi

  
    msg "${CYAN_NEON}Instalando wallpapers personalizados em: $target_folder${NC}" \
        "${CYAN_NEON}Installing custom wallpapers at: $target_folder${NC}" \
        "${CYAN_NEON}Instalando fondos de pantalla personalizados en: $target_folder${NC}"
    echo ""

    if ! "${como_user[@]}" mkdir -p "$target_folder"; then
        [ -n "$zip_temp" ] && rm -f "$zip_temp"
        msg "${RED_NEON}[ERRO] Não foi possível criar a pasta de destino: $target_folder${NC}" \
            "${RED_NEON}[ERROR] Could not create the destination folder: $target_folder${NC}" \
            "${RED_NEON}[ERROR] No se pudo crear la carpeta de destino: $target_folder${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        return 1
    fi

    if "${como_user[@]}" unzip -q -o -j "$zip_usar" -d "$target_folder"; then
        [ -n "$zip_temp" ] && rm -f "$zip_temp"
        qtd_imgs=$(find "$target_folder" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | wc -l)
        msg "${CYAN_NEON}[SUCESSO] Wallpapers instalados com sucesso em: $target_folder ($qtd_imgs imagens)${NC}" \
            "${CYAN_NEON}[SUCCESS] Wallpapers successfully installed at: $target_folder ($qtd_imgs images)${NC}" \
            "${CYAN_NEON}[ÉXITO] Fondos de pantalla instalados con éxito en: $target_folder ($qtd_imgs imágenes)${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        return 0
    fi

    [ -n "$zip_temp" ] && rm -f "$zip_temp"
    msg "${RED_NEON}[ERRO] Falha ao descompactar o pacote de wallpapers.${NC}" \
        "${RED_NEON}[ERROR] Failed to extract the wallpapers package.${NC}" \
        "${RED_NEON}[ERROR] Error al descomprimir el paquete de fondos de pantalla.${NC}"
    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
    return 1
}
