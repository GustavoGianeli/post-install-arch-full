                    echo ""
                    continue
                fi
            fi

            # Seleciona qual helper utilizar caso ambos estejam instalados
            local chosen_helper=""
            if [ $has_yay -eq 1 ] && [ $has_paru -eq 1 ]; then
                while true; do
                    msg "${CYAN_NEON}Ambos os helpers (yay e paru) estão instalados. Qual deseja usar para instalar $pkg_name?${NC}" \
                        "${CYAN_NEON}Both helpers (yay and paru) are installed. Which one do you want to use to install $pkg_name?${NC}" \
                        "${CYAN_NEON}Ambos los helpers (yay y paru) están instalados. ¿Cuál desea usar para instalar $pkg_name?${NC}"
                    echo ""

