            if [ "${#pacotes_com_falha[@]}" -gt 0 ]; then
                echo ""
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                msg "${YELLOW_NEON}[AVISO]: Não foi possível instalar: ${pacotes_com_falha[*]}${NC}" \
