                    "${YELLOW_NEON}[AVISO]: No se pudo instalar: ${pacotes_com_falha[*]}${NC}"
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"   
            fi
        fi

        echo ""
        msg "-> ${CYAN_NEON}Codecs e pacotes de mídia instalados com sucesso!${NC}" \
            "-> ${CYAN_NEON}Codecs and media packages installed successfully!${NC}" \
            "-> ${CYAN_NEON}¡Códecs y paquetes de medios instalados con éxito!${NC}"
}

