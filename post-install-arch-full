#===========================================================================================
#COMEÇO DAS FUNÇÕES DE CADA OPÇÃO DO MENU // START OF EACH MENU OPTION FUNCTIONS
#===========================================================================================

FUNCAO_CORE(){

    _core_sep() { echo -e "${NEON_BLUE}\n------------------------------------------------------------${NC}"; }

    _core_skip() {
        msg "-> Pulando esta etapa." "-> Skipping this step." "-> Saltando este paso."
    }

    _core_ask_yn() {
        local answer
        while true; do
            msg "$1" "$2" "$3"
            if ! read -r -p "> " answer; then
                echo
                return 1
            fi
            answer="${answer//[[:space:]]/}"
            answer="${answer,,}"
            case "$answer" in
                s|sim|y|yes|si|sí) return 0 ;;
                n|nao|não|no) return 1 ;;
                *) msg "${RED_NEON}[ERRO]: Opção inválida.${NC}" "${RED_NEON}[ERROR]: Invalid option.${NC}" "${RED_NEON}[ERROR]: Opción no válida.${NC}" ;;
            esac
        done
    }

    _core_install() {
        if sudo pacman -S --needed --noconfirm "$@"; then
            msg "-> Pacotes instalados: $*" "-> Packages installed: $*" "-> Paquetes instalados: $*"
            return 0
        fi
        msg "${RED_NEON}[ERRO]: Falha ao instalar: $* ${NC}" "${RED_NEON}[ERROR]: Failed to install: $* ${NC}" "${RED_NEON}[ERROR]: Error al instalar: $* ${NC}"
        return 1
    }

    _core_init_pkg() {
        if command -v systemctl &>/dev/null && pidof systemd &>/dev/null; then return 0; fi
        if command -v rc-service &>/dev/null && pacman -Si "$1-openrc" &>/dev/null; then
            _core_install "$1-openrc"
        fi
        return 0
    }

    _core_sudo_keepalive_start() {
        if [ -n "${CORE_SUDO_PID:-}" ] && kill -0 "$CORE_SUDO_PID" 2>/dev/null; then return 0; fi
        local parent_pid=$$
        (
            while kill -0 "$parent_pid" 2>/dev/null; do
                sudo -n true 2>/dev/null
                sleep 45
            done
        ) >/dev/null 2>&1 &
        CORE_SUDO_PID=$!
        disown "$CORE_SUDO_PID" 2>/dev/null
    }

    _core_sudo_keepalive_stop() {
    if [ -n "${CORE_SUDO_PID:-}" ]; then
        kill "$CORE_SUDO_PID" 2>/dev/null || true
        CORE_SUDO_PID=""
    fi
    }

    _core_has_bluetooth() {
    compgen -G "/sys/class/bluetooth/hci*" >/dev/null && return 0
    if command -v rfkill &>/dev/null && rfkill list bluetooth 2>/dev/null | grep -qi bluetooth; then return 0; fi
    return 1
    }

    _core_is_artix() { 
    [ -f /etc/artix-release ] || grep -qi '^ID=artix' /etc/os-release 2>/dev/null
    }

    _core_flathub() {
    if sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo; then
        msg "-> Flathub ativado." "-> Flathub enabled." "-> Flathub activado."
    else
        msg "${RED_NEON}[ERRO]: Falha ao ativar Flathub.${NC}" "${RED_NEON}[ERROR]: Failed to enable Flathub.${NC}" "${RED_NEON}[ERROR]: Error al activar Flathub.${NC}"
    fi
    }

    _core_draw_bar() {
    local atual=$1
    local total=$2
    local largura=20
    
    local porcentagem num_eq num_esp preenchimento vazios

    [ "$total" -le 0 ] && total=1
    [ "$atual" -gt "$total" ] && atual=$total

    porcentagem=$(( atual * 100 / total ))
    num_eq=$(( atual * largura / total ))
    num_esp=$(( largura - num_eq ))

    preenchimento=$(printf '%*s' "$num_eq" '' | tr ' ' '=')
    vazios=$(printf '%*s' "$num_esp" '' | tr ' ' ' ')

    printf "\r\e[K   Executando testes… [\e[32m%s\e[0m%s] \e[1;33m%3d%%\e[0m concluídos" \
        "$preenchimento" "$vazios" "$porcentagem"
    }

    #==========================
    local resp_audio mirror_target reflector_ok ucode_pkg root_fs
    local efi_dir conf limine_conf user_uid mirror_run_bak
    local base_pkgs=(git base-devel dkms curl wget exfatprogs htop unrar tar gzip bzip2 xz lrzip p7zip ntfs-3g dosfstools lm_sensors fastfetch)
    local target_user="${SUDO_USER:-${USER:-$(id -un)}}"

    echo -e "${CYAN_NEON}\n============================================================${NC}"
    echo ""
    msg "${CYAN_NEON}[CORE]:${NC} ${NEON_BLUE}Iniciando configurações essenciais do Project Odin...${NC}" \
        "${CYAN_NEON}[CORE]:${NC} ${NEON_BLUE}Starting essential configurations for Project Odin...${NC}" \
        "${CYAN_NEON}[CORE]:${NC} ${NEON_BLUE}Iniciando configuraciones esenciales del Project Odin...${NC}"
        sleep 0.2
    echo -e "${PINK_NEON}\n============================================================${NC}"
    _core_sep
    echo ""
    msg "${YELLOW_NEON}[1/15]: Solicitando credenciais de sudo...${NC}" \
        "${YELLOW_NEON}[1/15]: Requesting sudo credentials...${NC}" \
        "${YELLOW_NEON}[1/15]: Solicitando credenciales de sudo...${NC}"
        echo ""
    if ! sudo -v; then
        msg "${RED_NEON}[ERRO]:  Não foi possível validar o sudo. Abortando o CORE.!${NC}" \
            "${RED_NEON}[ERROR]: Could not validate sudo. Aborting CORE.!${NC}" \
            "${RED_NEON}[ERROR]: No se pudo validar sudo. Abortando el CORE.!${NC}"
        return 1
    fi
    _core_sudo_keepalive_start
    msg "-> Sudo validado e keep-alive ativo." \
        "-> Sudo validated and keep-alive active." \
        "-> Sudo validado y keep-alive activo."
    
    sleep 0.2
    #echo -e "${NEON_BLUE}---------------------------------------------------------------- [2/15]${NC}"
    _core_sep
    echo ""
    msg "${CYAN_NEON}[2/15]: Sincronizando o relógio do sistema (NTP)...${NC}" \
        "${CYAN_NEON}[2/15]: Synchronizing system clock (NTP)...${NC}" \
        "${CYAN_NEON}[2/15]: Sincronizando el reloj del sistema (NTP)...${NC}"
    echo ""
    if command -v timedatectl &>/dev/null && pidof systemd &>/dev/null; then
        sudo timedatectl set-ntp true
        msg "-> NTP ativado via systemd. Relógio sincronizado." \
            "-> NTP enabled via systemd. Clock synced." \
            "-> NTP activado vía systemd. Reloj sincronizado."
    elif command -v rc-service &>/dev/null; then
        if pacman -Q chrony &>/dev/null; then
            manage_service enable chronyd
            manage_service start chronyd
        elif pacman -Q ntp &>/dev/null; then
            manage_service enable ntpd
            manage_service start ntpd
        elif _core_ask_yn "Nenhum cliente NTP encontrado. Instalar o chrony? [s/n]" \
                          "No NTP client found. Install chrony? [y/n]" \
                          "Ningún cliente NTP encontrado. ¿Instalar chrony? [s/n]"; then
            if _core_install chrony; then
                _core_init_pkg chrony
                manage_service enable chronyd
                manage_service start chronyd
            fi
        else
            _core_skip
        fi
    else
        _core_skip
    fi

