                "${YELLOW_NEON}[AVISO]: La instalación en bloque falló. Intentando instalar un paquete a la vez...${NC}"
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            echo ""
            for pacote in "${pacotes_disponiveis[@]}"; do
                if ! sudo pacman -S --needed --noconfirm "$pacote"; then
                    pacotes_com_falha+=("$pacote")
                fi
            done

            # Nenhum pacote foi instalado: falha real
            if [ "${#pacotes_com_falha[@]}" -eq "${#pacotes_disponiveis[@]}" ]; then
                echo ""
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                msg "${RED_NEON}[ERRO]: Falha ao instalar os codecs de multimídia.${NC}" \
