                "1) Controlador Propietario Estándar (nvidia, nvidia-utils, lib32-nvidia-utils si multilib está activo)"
            
            echo ""

            msg "2) Driver Kernel Aberto / Open-source (nvidia-open)" \
                "2) Open Kernel Modules Driver (nvidia-open)" \
                "2) Controlador de Módulos de Kernel Abierto (nvidia-open)"
            
            echo ""

            msg "0) Pular otimização NVIDIA" \
                "0) Skip NVIDIA optimization" \
                "0) Omitir optimización NVIDIA"

            read -rp "Escolha / Choice / Opción: " nv_opt || return 1

            local pkgs=()
            case "$nv_opt" in
                1)
                    pkgs+=("nvidia" "nvidia-utils")
                    if grep -q "^\[multilib\]" /etc/pacman.conf 2>/dev/null; then
                        pkgs+=("lib32-nvidia-utils")
                    fi
                    ;;
                2)
                    pkgs+=("nvidia-open" "nvidia-utils")
                    if grep -q "^\[multilib\]" /etc/pacman.conf 2>/dev/null; then
                        pkgs+=("lib32-nvidia-utils")
                    fi
                    ;;
                0)
                    msg "${CYAN_NEON}Otimização NVIDIA ignorada.${NC}" \
                        "${CYAN_NEON}NVIDIA optimization skipped.${NC}" \
                        "${CYAN_NEON}Optimización NVIDIA omitida.${NC}"
                    echo ""
                    return 0
                    ;;
                *)
                    msg "${YELLOW_NEON}Comando inválido! Tente novamente.${NC}" \
                        "${YELLOW_NEON}Invalid command! Try again.${NC}" \
                        "${YELLOW_NEON}¡Comando inválido! Inténtelo de nuevo.${NC}"
                    echo ""
                    continue
                    ;;
            esac

            msg "Instalando componentes NVIDIA: ${pkgs[*]}..." \
                "Installing NVIDIA components: ${pkgs[*]}..." \
                "Instalando componentes NVIDIA: ${pkgs[*]}..."

            if sudo pacman -S --needed --noconfirm "${pkgs[@]}"; then
            echo ""
                msg "${CYAN_NEON}Componentes NVIDIA instalados com sucesso.${NC}" \
                    "${CYAN_NEON}NVIDIA components successfully installed.${NC}" \
                    "${CYAN_NEON}Componentes NVIDIA instalados con éxito.${NC}"
                rc=0
            else
            echo ""
                msg "${RED_NEON}Falha na instalação dos componentes NVIDIA.${NC}" \
                    "${RED_NEON}Failed to install NVIDIA components.${NC}" \
                    "${RED_NEON}Error al instalar los componentes NVIDIA.${NC}"
                rc=1
            fi
            echo ""
            break
        done
        return $rc
    }

    # ==============================================================================
