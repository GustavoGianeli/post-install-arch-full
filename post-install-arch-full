                                    "Failed to install yay-bin." \
                                    "Error al instalar yay-bin."
                                rm -rf "$tmp_dir"
                            fi
                            ;;
                        2)
                            msg "Instalando paru-bin..." \
                                "Installing paru-bin..." \
                                "Instalando paru-bin..."
                            echo ""

                            local tmp_dir
                            tmp_dir=$(mktemp -d) || return 1

                            if sudo pacman -S --needed --noconfirm git base-devel rust && \
                               git clone https://aur.archlinux.org/paru-bin.git "$tmp_dir/paru-bin" && \
