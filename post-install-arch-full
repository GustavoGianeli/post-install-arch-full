                                "¡Comando inválido! Inténtelo de nuevo."
                            
                            echo ""
                            ;;
                    esac
                done

                # Se cancelou ou falhou na instalação do helper, retorna ao menu principal
                if [ $helper_installed -eq 0 ] && [ $has_yay -eq 0 ] && [ $has_paru -eq 0 ]; then
                    msg "${YELLOW_NEON}Nenhum helper disponível. Cancelando $pkg_name e retornando ao menu...${NC}" \
