                chosen_helper="yay"
            elif [ $has_paru -eq 1 ]; then
                chosen_helper="paru"
            fi

            msg "Instalando $pkg_name utilizando $chosen_helper..." \
                "Installing $pkg_name using $chosen_helper..." \
