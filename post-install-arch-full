            rc=1
        fi
    fi

    # Detecção de CPU
    if grep -q "AuthenticAMD" /proc/cpuinfo 2>/dev/null; then
        DETECTED_CPU="AMD"
    elif grep -q "GenuineIntel" /proc/cpuinfo 2>/dev/null; then
        DETECTED_CPU="INTEL"
    else
        DETECTED_CPU="UNKNOWN"
    fi

    # Detecção precisa de GPUs utilizando os Vendor IDs oficiais do PCI
    local pci_gpus=""
    if command -v lspci &> /dev/null; then
        pci_gpus=$(lspci -nn 2>/dev/null | grep -E "VGA|3D|Display")
    fi

    HAS_INTEL_GPU=0
    HAS_AMD_GPU=0
    HAS_NVIDIA_GPU=0

    # [8086: = Intel, [1002: = AMD/ATI, [10de: = NVIDIA
    echo "$pci_gpus" | grep -qi "\[8086:" && HAS_INTEL_GPU=1
    echo "$pci_gpus" | grep -qi "\[1002:" && HAS_AMD_GPU=1
    echo "$pci_gpus" | grep -qi "\[10de:" && HAS_NVIDIA_GPU=1
    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
    msg "[OK] Detecção de Hardware Concluída:" \
        "[OK] Hardware Detection Completed:" \
        "[OK] Detección de Hardware Completada:"
    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
    echo ""

    msg " -> CPU: $DETECTED_CPU" \
