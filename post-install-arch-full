OTIMIZAR_HARDWARE() {
    local rc=0
    echo ""
    echo -e "${NEON_BLUE}===============================================================${NC}"
    msg "${CYAN_NEON}Investigando o hardware do sistema...${NC}" \
        "${CYAN_NEON}Investigating system hardware...${NC}" \
        "${CYAN_NEON}Investigando el hardware del sistema...${NC}"
    echo -e "${NEON_BLUE}===============================================================${NC}"
    
    echo ""

    if ! command -v lspci &> /dev/null; then
        msg "Instalando pciutils para auditoria de hardware..."\
             "Installing pciutils for hardware auditing..."\
             "Instalando pciutils para auditoría de hardware..."
        
        if ! sudo pacman -S --needed --noconfirm pciutils; then
            msg "${RED_NEON}Falha ao instalar pciutils. A detecção de GPU pode ser comprometida.${NC}"\
                 "${RED_NEON}Failed to install pciutils. GPU detection may be compromised.${NC}"\
                 "${RED_NEON}Error al instalar pciutils. La detección de GPU puede verse comprometida.${NC}"
            rc=1
        fi
    fi

    # Detecção de CPU
    if grep -q "AuthenticAMD" /proc/cpuinfo 2>/dev/null; then
        DETECTED_CPU="AMD"
    elif grep -q "GenuineIntel" /proc/cpuinfo 2>/dev/null; then
        DETECTED_CPU="INTEL"
    else
        DETECTED_CPU="UNKNOWN"
    fi

    # Detecção precisa de GPUs utilizando os Vendor IDs oficiais do PCI
    local pci_gpus=""
    if command -v lspci &> /dev/null; then
        pci_gpus=$(lspci -nn 2>/dev/null | grep -E "VGA|3D|Display")
    fi

    HAS_INTEL_GPU=0
    HAS_AMD_GPU=0
    HAS_NVIDIA_GPU=0

    # [8086: = Intel, [1002: = AMD/ATI, [10de: = NVIDIA
    echo "$pci_gpus" | grep -qi "\[8086:" && HAS_INTEL_GPU=1
    echo "$pci_gpus" | grep -qi "\[1002:" && HAS_AMD_GPU=1
    echo "$pci_gpus" | grep -qi "\[10de:" && HAS_NVIDIA_GPU=1

    msg "[OK] Detecção de Hardware Concluída:" \
        "[OK] Hardware Detection Completed:" \
        "[OK] Detección de Hardware Completada:"

    echo ""

    msg " -> CPU: $DETECTED_CPU" \
        " -> CPU: $DETECTED_CPU" \
        " -> CPU: $DETECTED_CPU"

   [ "$HAS_INTEL_GPU" -eq 1 ] && msg " -> GPU Intel identificada." \
                                      " -> Intel GPU identified." \
                                      " -> GPU Intel identificada."
    [ "$HAS_AMD_GPU" -eq 1 ] && msg " -> GPU AMD identificada." \
                                    " -> AMD GPU identified." \
                                    " -> GPU AMD identificada."
    [ "$HAS_NVIDIA_GPU" -eq 1 ] && msg " -> GPU NVIDIA identificada." \
                                       " -> NVIDIA GPU identified." \
                                       " -> GPU NVIDIA identificada."


    if [ "$HAS_INTEL_GPU" -eq 0 ] && [ "$HAS_AMD_GPU" -eq 0 ] && [ "$HAS_NVIDIA_GPU" -eq 0 ]; then

        msg "${YELLOW_NEON}Aviso: Nenhuma GPU reconhecida foi detectada automaticamente.${NC}" \
            "${YELLOW_NEON}Warning: No recognized GPU was automatically detected.${NC}" \
             "${YELLOW_NEON}Advertencia: No se detectó automáticamente ninguna GPU reconocida.${NC}"
    fi

    echo ""
    return $rc
    }

    # ==============================================================================
    # SUBFUNÇÃO 2: Otimização para GPUs AMD / Intel (Mesa / Vulkan)
    # ==============================================================================
    otimizar_gpu_mesa() {
        local vendor="$1"
        local pkgs=()
        local rc=0
        echo ""
        msg "${CYAN_NEON}[GPU - $vendor] Configurando pilha gráfica aberta (Mesa/Vulkan)...${NC}" \
            "${CYAN_NEON}[GPU - $vendor] Configuring open graphics stack (Mesa/Vulkan)...${NC}" \
            "${CYAN_NEON}[GPU - $vendor] Configurando pila gráfica abierta (Mesa/Vulkan)...${NC}"

        # Pacotes básicos de 64 bits (removido xf86-video-amdgpu obsoleto)
        pkgs+=("mesa")

        if [ "$vendor" == "AMD" ]; then
            pkgs+=("vulkan-radeon" "libva-mesa-driver")
        elif [ "$vendor" == "INTEL" ]; then
            pkgs+=("vulkan-intel" "intel-media-driver")
        fi

        # Suporte a 32 bits (multilib) se habilitado no pacman.conf
        if grep -q "^\[multilib\]" /etc/pacman.conf 2>/dev/null; then
            pkgs+=("lib32-mesa")
            if [ "$vendor" == "AMD" ]; then
                pkgs+=("lib32-vulkan-radeon")
            elif [ "$vendor" == "INTEL" ]; then
                pkgs+=("lib32-vulkan-intel")
            fi
        fi
        echo ""
        msg "${CYAN_NEON}Instalando/Verificando pacotes gráficos para $vendor: ${pkgs[*]}${NC}" \
            "${CYAN_NEON}Installing/Checking graphics packages for $vendor: ${pkgs[*]}${NC}" \
            "${CYAN_NEON}Instalando/Verificando paquetes gráficos para $vendor: ${pkgs[*]}${NC}"
     
        echo ""
        if sudo pacman -S --needed --noconfirm "${pkgs[@]}"; then
            msg "Pacotes gráficos para $vendor instalados com sucesso." \
                "Graphics packages for $vendor successfully installed." \
                "Paquetes gráficos para $vendor instalados con éxito."
        else
            msg "Falha ao instalar pacotes gráficos para $vendor." \
                "Failed to install graphics packages for $vendor." \
                "Error al instalar paquetes gráficos para $vendor."
            rc=1
        fi
        echo ""
        return $rc
    }

    # ==============================================================================
    # SUBFUNÇÃO 3: Otimização para GPUs NVIDIA
    # ==============================================================================
    otimizar_gpu_nvidia() {
        local rc=0

        msg  "${CYAN_NEON}[GPU - NVIDIA] Configurando placa gráfica NVIDIA..." \
             "${CYAN_NEON}[GPU - NVIDIA] Configuring NVIDIA graphics card..." \
             "${CYAN_NEON}[GPU - NVIDIA] Configurando tarjeta gráfica NVIDIA..."
