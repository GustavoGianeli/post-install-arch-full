                        "2) Install 'paru'" \
                        "2) Instalar 'paru'"
                    
                    echo ""

                    msg "0) Cancelar instalação de $pkg_name" \
                        "0) Cancel $pkg_name installation" \
                        "0) Cancelar instalación de $pkg_name"
                    echo ""
                    read -rp "Escolha / Choice / Opción: " h_inst || return 1

                    case "$h_inst" in
                        1)
                            msg "Instalando yay-bin..." \
                                "Installing yay-bin..." \
                                "Instalando yay-bin..."
                            echo ""

                            local tmp_dir
                            tmp_dir=$(mktemp -d) || return 1

                            if sudo pacman -S --needed --noconfirm git base-devel go && \
