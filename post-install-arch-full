    otimizar_gpu_mesa() {
        sleep 0.5
        local vendor="$1"
        local pkgs=()
        local rc=0
        echo ""
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        msg "${CYAN_NEON}[GPU - $vendor] Configurando pilha gráfica aberta (Mesa/Vulkan)...${NC}" \
            "${CYAN_NEON}[GPU - $vendor] Configuring open graphics stack (Mesa/Vulkan)...${NC}" \
            "${CYAN_NEON}[GPU - $vendor] Configurando pila gráfica abierta (Mesa/Vulkan)...${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        # Pacotes básicos de 64 bits (removido xf86-video-amdgpu obsoleto)
        pkgs+=("mesa")

        if [ "$vendor" == "AMD" ]; then
            # libva-mesa-driver não é mais um pacote próprio: o 'mesa' já o fornece (provides)
            pkgs+=("vulkan-radeon")
        elif [ "$vendor" == "INTEL" ]; then
            pkgs+=("vulkan-intel" "intel-media-driver")
        fi

        # Suporte a 32 bits (multilib) se habilitado no pacman.conf
        if grep -q "^\[multilib\]" /etc/pacman.conf 2>/dev/null; then
