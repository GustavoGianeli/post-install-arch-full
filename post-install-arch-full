    # ==============================================================================
    otimizar_validar_resultado() {
        local has_errors="${1:-0}"

        msg "${YELLOW_NEON}[AUDITORIA]:${NC} Validando otimizações de hardware aplicadas..." \
            "${YELLOW_NEON}[AUDITORIA]:${NC} Validating applied hardware optimizations..." \
            "${YELLOW_NEON}[AUDITORIA]:${NC} Validando optimizaciones de hardware aplicadas..."

        if [ "$has_errors" -eq 0 ]; then
            msg "Otimização de hardware do Project Odin concluída com sucesso!" \
                "Project Odin hardware optimization successfully completed!" \
                "¡Optimización de hardware de Project Odin completada con éxito!"
        else
            msg "A otimização foi concluída, mas ocorreram avisos ou falhas em etapas anteriores." \
                "Optimization completed, but warnings or errors occurred in previous steps." \
                "La optimización se completó, pero ocurrieron advertencias o fallas en pasos anteriores."
        fi
        echo ""
    }

    # ==============================================================================
    # FUNÇÃO PRINCIPAL
    # ==============================================================================
    FUNCAO_OTIMIZACAO() {
        msg "=== PROJECT ODIN · OTIMIZAÇÃO DE HARDWARE E DRIVERS ===" \
            "=== PROJECT ODIN · HARDWARE & DRIVER OPTIMIZATION ===" \
            "=== PROJECT ODIN · OPTIMIZACIÓN DE HARDWARE Y CONTROLADORES ==="
        echo ""

        local global_error=0

        otimizar_detectar_hardware || global_error=1

            # 2. Otimização para GPUs Integradas / Pilha Aberta
        if [ "$HAS_AMD_GPU" -eq 1 ]; then
            otimizar_gpu_mesa "AMD" || global_error=1
        fi

        if [ "$HAS_INTEL_GPU" -eq 1 ]; then
            otimizar_gpu_mesa "INTEL" || global_error=1
        fi

        # 3. Otimização para GPU Dedicada NVIDIA
        if [ "$HAS_NVIDIA_GPU" -eq 1 ]; then
            otimizar_gpu_nvidia || global_error=1
        fi

        # 4. Auditoria Real
        otimizar_validar_resultado "$global_error"

        return "$global_error"
    
